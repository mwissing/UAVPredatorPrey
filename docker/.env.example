# Copy this file to docker/.env and adjust only host-specific values.

# Isolate this stack from the legacy Isaac 5.0 Compose project and volumes.
COMPOSE_PROJECT_NAME=uavpredatorprey-isaac51
DOCKER_NAME_SUFFIX=-uav51

UAVPREDATORPREY_ROOT=/home/marc/RL/UAVPredatorPrey
ARTIFACTS_ROOT=/home/marc/RL/artifacts

HOST_UID=1000
HOST_GID=1000
# Group owning /isaac-sim in the pinned NVIDIA Isaac Sim 5.1.0 image.
ISAACSIM_GID=1234
RUNTIME_USER=ubuntu
DOCKER_USER_HOME=/home/ubuntu

ISAACLAB_COMMIT=f4aa17f87e2e5db5484f0b5974918573e8918ce2
ISAACLAB_BASE_IMAGE=isaac-lab-base-uav51:latest
UAV_ISAAC_IMAGE=uavpredatorprey-isaaclab:f4aa17f-sim5.1.0-skrl1.4.3
UAV_VOLUME_PREFIX=uavpredatorprey-isaacsim-5.1.0
